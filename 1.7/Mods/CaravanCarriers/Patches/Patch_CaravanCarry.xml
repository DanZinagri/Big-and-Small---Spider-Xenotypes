<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Caravan riding speed for the spider bodies. Only loads with Caravan Carriers (DanZinagri.CaravanCarriers):
       vanilla treats every humanlike as a rider and ignores this stat on them, so without that mod it would only be
       a gene-tooltip line that does nothing. With it, the spider carries one caravan member at this speed, the way a
       rideable animal does. statFactors on a base of 1.0, so 1.4 means 140%.
       Each gene is checked first: add to its statFactors if it has one, otherwise give it one. -->

    <!-- DZ_SpiderBody_Arakron (Arakron): 160% -->
    <Operation Class="PatchOperationConditional">
    <xpath>Defs/GeneDef[defName="DZ_SpiderBody_Arakron"]/statFactors</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/GeneDef[defName="DZ_SpiderBody_Arakron"]/statFactors</xpath>
      <value>
        <CaravanRidingSpeedFactor>1.6</CaravanRidingSpeedFactor>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/GeneDef[defName="DZ_SpiderBody_Arakron"]</xpath>
      <value>
        <statFactors>
          <CaravanRidingSpeedFactor>1.6</CaravanRidingSpeedFactor>
        </statFactors>
      </value>
    </nomatch>
  </Operation>

